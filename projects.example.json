{
  "cacheDir": "~/Library/Caches/overleaf-mcp",
  "syncTtlSeconds": 30,
  "projects": {
    "MyPaper": {
      "name": "My Paper",
      "projectId": "YOUR_24_HEX_OVERLEAF_PROJECT_ID",
      "gitToken": "olp_YOUR_OVERLEAF_GIT_TOKEN",
      "mainFile": "main.tex",
      "engine": "pdflatex",
      "headings": [
        "rSection"
      ],
      "selfAuthors": [
        "YourSurname"
      ]
    }
  },
  "verify": {
    "enabled": true,
    "timeoutMs": 15000,
    "thresholds": {
      "accept": 0.85,
      "consider": 0.6
    }
  }
}
