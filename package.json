{
  "name": "overleaf-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for reading, compiling, and editing Overleaf projects via the git bridge",
  "type": "module",
  "main": "overleaf-mcp-server.js",
  "bin": {
    "overleaf-mcp": "./overleaf-mcp-server.js"
  },
  "scripts": {
